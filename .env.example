# AarogyaConnect AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite Database Location
DATABASE_URL=sqlite:///./aarogya_hospital.db

# Sarvam AI Official Configuration
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# Generic LLM Configuration (fallback / compatibility)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Hospital Operator Portal Credentials (Demo Environment)
OPERATOR_USERNAME=operator@aarogya.org
OPERATOR_PASSWORD=AarogyaOp@2026
OPERATOR_SECRET_KEY=aarogya-hospital-operations-secret-key-2026-prototype
OPERATOR_TOKEN_EXPIRE_HOURS=12
